<?xml version="1.0"?>
<odoo>
    <!-- POS -->
    <record id="manager_action_pos_config_kanban" model="ir.actions.act_window">
        <field name="name">Tableau de bord</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain"></field>
    </record>

    <!-- INVENTAIRE -->
    <record id="manager_inventory_action_picking" model="ir.actions.act_window">
        <field name="name">Vue d'ensemble</field>
        <field name="res_model">stock.picking.type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">kanban,form</field>
    </record>
    <record id="manager_inventory_action_move" model="ir.actions.act_window">
        <field name="name">Transferts</field>
        <field name="res_model">stock.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="stock.view_move_tree" />
        <field name="search_view_id" ref="stock.view_move_search" />
        <field name="context">{'search_default_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock move found
            </p>
            <p>
                This menu gives you the full traceability of inventory
                operations on a specific product. You can filter on the product
                to see all the past or future movements for the product.
            </p>
        </field>
    </record>
    <record id="manager_inventory_action_move_line" model="ir.actions.act_window">
        <field name="name">Historique des mouvements de stocks</field>
        <field name="res_model">stock.move.line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,pivot,form</field>
        <field name="view_id" ref="stock.view_move_line_tree" />
        <field name="context">{'search_default_done': 1, 'create': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                There's no product move yet
            </p>
            <p>
                This menu gives you the full traceability of inventory operations on a specific
                product.
                You can filter on the product to see all the past movements for the product.
            </p>
        </field>
    </record>

    <record id="manager_inventory_action_stock_quant" model="ir.actions.act_window">
        <field name="context">{'search_default_productgroup':1}</field>
        <field name="domain">[]</field>
        <field name="name">Stock actuel</field>
        <field name="res_model">stock.quant</field>
        <field name="view_id" ref="stock.view_stock_quant_tree"/> 
    </record>

    <record id="manager_inventory_action_stock_ajustement" model="ir.actions.act_window" >
        <field name="name">Ajustements de stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_id" ref="stock.view_stock_quant_tree_inventory_editable"/>                      
    </record>

    <!-- MENUS POUR LE MANAGER DE COMPTOIR DE CHANGE-->
    <menuitem name="Comptoir de Change (gestionnaire)"
    id="cdc_manager_menu_root"
    parent="base.menu_custom">
        <!-- MENUS POS -->
        <menuitem id="exchange_counter_manager_pos" name="Comptoir de Change">
            <menuitem id="manager_menu_pos_config" action="manager_action_pos_config_kanban"/>
        </menuitem>
        <!-- MENUS INVENTAIRE -->
        <menuitem id="exchange_counter_manager_inventaire" name="Inventaire">
            <menuitem id="manager_menu_stock_picking" action="manager_inventory_action_picking"/>
            <menuitem id="manager_menu_stock_move" action="manager_inventory_action_move"/>
            <menuitem id="manager_menu_stock_move_line" action="manager_inventory_action_move_line"/>
            <menuitem id="manager_menu_stock_quant" action="manager_inventory_action_stock_quant"/>
            <menuitem id="manager_menu_stock_inventory_ajustement" action="manager_inventory_action_stock_ajustement"/>
        </menuitem>
    </menuitem>
</odoo>