<?xml version="1.0"?>
<odoo>
    <data>
        <record id="lcc_fss_form_view" model="ir.ui.view">
            <field name="name">LCC FSS Members Form View</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="lcc_members.lcc_members_form_view" />
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <!-- ################### -->
                <!-- MAIN DISPLAY UPDATE -->
                <!-- ################### -->
                <xpath expr="//field[@name='currency_exchange_office']" position="replace" />
                <xpath expr="//field[@name='title']" position="replace" />
                <xpath expr="//field[@name='function']" position="replace" />
                <xpath expr="//field[@name='gender']" position="replace" />

                <!-- ################ -->
                <!-- NOTEBOOK UPDATES -->
                <!-- ################ -->

                <!-- page Personnal Information -->
                <xpath expr="//page[@name='personal_information_page']" position='inside'>
                    <group name="fss_data_credit"
                        string="FSS data to compute credit amount "
                        attrs="{'invisible': [('is_company', '=', True)]}" >
                        <field name="reference_tax_income" />
                        <field name="number_of_tax_shares" />
                        <field name="fss_quotient" />
                        <field name="initial_contribution_tranche" />
                        <field name="number_of_increases" />
                        <field name="reason_for_increases" />
                        <field name="number_of_decreases" />
                        <field name="reason_for_decreases" />
                        <field name="contribution_reference_tranche" />
                        <field name="number_of_allocation_units" />
                        <field name="allocation_amount" />
                        <field name="contribution_amount" />
                        <field name="contract_start_date" />
                    </group>
                    <group name="fss_household_composition" string="Household composition"
                        attrs="{'invisible': [('is_company', '=', True)]}">
                        <field name="household_composition_adults" />
                        <field name="household_composition_children" />
                        <field name="household_child_allowance" widget="radio"/>
                        <field name="household_child_allowance_other" attrs="{'invisible': [('household_child_allowance', '!=', 'other')]}"/>
                        <field name="name_of_allocation_beneficiary" />
                    </group>
                    <group name="fss_third_party" attrs="{'invisible': [('is_company', '=', True)]}">
                        <field name="employer_id"  />
                        <field name="third_party_payer" />
                    </group>
                    <group name="fss_experimentation_evaluation_data"
                        string="FSS experimentation evaluation data"
                        attrs="{'invisible': [('is_company', '=', True)]}" >
                        <field name="gender" />
                        <field name="birth_year" />
                        <field name="arrival_year_territory" />
                        <field name="socio_professional_category" />
                        <field name="monthly_household_food_budget" />
                        <field name="food_system_worker" widget="radio" />
                        <field name="food_system_worker_other" attrs="{'invisible': [('food_system_worker', '=', 'no')]}"/>
                        <field name="housing_status" widget="radio" />
                    </group>
                    <group name="fss_pos_data"
                        string="FSS Point of sale informations"
                        attrs="{'invisible': [('is_company', '=', False)]}">
                        <field name="subscription_date" />
                        <field name="annual_sales" />
                        <field name="annual_sales_year" />
                        <field name="contribution" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>