<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- =========================================================== -->
        <!-- Default Monujo configuration                                -->
        <!-- =========================================================== -->
        <!-- Values mirror monujo/public/config.sample.json so a fresh   -->
        <!-- install yields a working /config endpoint out of the box.  -->
        <!-- =========================================================== -->

        <record id="lcc_monujo_config_default" model="lcc.monujo.config">
            <field name="name">Default</field>
            <field name="ident">default</field>
            <field name="is_default" eval="True"/>
            <field name="sequence">1</field>

            <field name="lokapi_db">odoo</field>
            <field name="lokapi_host">example.org</field>
            <field name="map_url">https://carte.example.org</field>
            <field name="help_url">https://help.com</field>
            <field name="cgu_url">https://cgu.com</field>

            <field name="locales_app_strings_language">en-US</field>
            <field name="locales_default_language">en-US</field>
            <field name="locales_prefer_navigator_language" eval="True"/>

            <field name="accounts_refresh_interval">90</field>
            <field name="transactions_refresh_interval">47</field>
            <field name="currencies_refresh_interval">60</field>

            <field name="disable_reconversion" eval="False"/>
            <field name="disable_top_up" eval="False"/>
            <field name="disable_split_memo" eval="False"/>
            <field name="disable_badges" eval="False"/>
            <field name="disable_import_wallet" eval="False"/>
            <field name="disable_display_other_unpaid_topup" eval="False"/>

            <field name="css">.nav-item {color: red !important} .refresh {background-color: #009688;}</field>
            <field name="local_auth_policy">["Retention", {"time": 900, "subConfig": ["Pin", {}]}]</field>
        </record>

        <!-- =========================================================== -->
        <!-- Default available language: English (no translation file —  -->
        <!-- the Monujo app bundles English strings at build time).      -->
        <!-- =========================================================== -->

        <record id="lcc_monujo_config_default_lang_en" model="lcc.monujo.config.language">
            <field name="config_id" ref="lcc_monujo_config_default"/>
            <field name="lang_id" ref="base.lang_en"/>
        </record>

