<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Sequence for recurrent contract reference -->
    <record id="sequence_payment_request_recurrent_contract" model="ir.sequence">
        <field name="name">Payment Request Recurrent Contract</field>
        <field name="code">payment.request.recurrent.contract</field>
        <field name="prefix">PRC/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>

    <data noupdate="1">
        <!-- Cron job to generate recurring payment requests -->
        <record model="ir.cron" id="contract_cron_for_payment_request">
            <field name="name">Generate Recurring Payment Requests from Contracts</field>
            <field name="model_id" ref="model_payment_request_recurrent_contract" />
            <field name="state">code</field>
            <field name="code">model._cron_recurring_create_payment_requests()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
