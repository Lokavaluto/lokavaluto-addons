<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_request_allowed_rule_view_tree" model="ir.ui.view">
        <field name="name">payment.request.allowed.rule.view.tree</field>
        <field name="model">payment.request.allowed.rule</field>
        <field name="arch" type="xml">
            <tree string="Payment Request Allowed Rules">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <field name="wallet_domain" />
                <field name="is_payment_request_allowed" />
            </tree>
        </field>
    </record>

    <record id="payment_request_allowed_rule_view_form" model="ir.ui.view">
        <field name="name">payment.request.allowed.rule.view.form</field>
        <field name="model">payment.request.allowed.rule</field>
        <field name="arch" type="xml">
            <form string="Payment Request Allowed Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}" />
                    <field name="active" invisible="True" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="domain" string="Wallet Domain">
                        <field
                            name="wallet_domain"
                            widget="domain"
                            options='{"model": "res.partner.backend"}' />
                    </group>
                    <group name="authorisation" string="Authorisation">
                        <field name="is_payment_request_allowed" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="payment_request_allowed_rule_view_search" model="ir.ui.view">
        <field name="name">payment.request.allowed.rule.view.search</field>
        <field name="model">payment.request.allowed.rule</field>
        <field name="arch" type="xml">
            <search string="Search payment request allowed rules">
                <field name="name" />
                <field name="wallet_domain" />
                <filter domain="[('active','=',True)]" string="Active" name="active" />
                <filter domain="[('active','=',False)]" string="Archived" name="archived" />
                <separator />
                <filter domain="[('is_payment_request_allowed','=',True)]" string="Payment Request ON"
                    name="payment_request_on" />
                <filter domain="[('is_payment_request_allowed','=',False)]" string="Payment Request OFF"
                    name="payment_request_off" />
            </search>
        </field>
    </record>
</odoo>
