<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_alt_currency_view_tree" model="ir.ui.view">
        <field name="name">res.alt.currency.view.tree</field>
        <field name="model">res.alt.currency</field>
        <field name="arch" type="xml">
            <tree string="Alternative Currencies">
                <field name="name" />
                <field name="engine" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="res_alt_currency_view_form" model="ir.ui.view">
        <field name="name">res.alt.currency.view.form</field>
        <field name="model">res.alt.currency</field>
        <field name="arch" type="xml">
            <form string="Alternative Currency">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}" />
                    <field name="active" invisible="True" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="definition" string="Definition">
                        <field name="engine" />
                    </group>
                    <group name="options" string="Options">
                      <field name="activate_automatic_topup" />
		      <field name="currency_unit_product_id" />
		      <field name="commission_product_id" />
                    </group>
                </sheet>
		<div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="res_alt_currency_view_search" model="ir.ui.view">
        <field name="name">res.alt.currency.view.search</field>
        <field name="model">res.alt.currency</field>
        <field name="arch" type="xml">
            <search string="Search Alternative Currencies">
                <field name="name" />
                <field name="engine" />
                <filter domain="[('active','=',True)]" string="Active" name="active" />
                <filter domain="[('active','=',False)]" string="Archived" name="archived" />
            </search>
        </field>
    </record>
</odoo>
