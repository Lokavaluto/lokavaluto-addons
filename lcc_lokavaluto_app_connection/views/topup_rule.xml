<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="topup_rule_view_tree" model="ir.ui.view">
        <field name="name">topup.rule.view.tree</field>
        <field name="model">topup.rule</field>
        <field name="arch" type="xml">
            <tree string="Topup Rules">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <field name="wallet_domain" />
                <field name="is_topup_allowed" />
            </tree>
        </field>
    </record>

    <record id="topup_rule_view_form" model="ir.ui.view">
        <field name="name">topup.rule.view.form</field>
        <field name="model">topup.rule</field>
        <field name="arch" type="xml">
            <form string="Topup Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}" />
                    <field name="active" invisible="True" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="domain" string="Wallet Domain">
                        <field
                            name="wallet_domain"
                            widget="domain"
                            options='{"model": "res.partner.backend"}' />
                    </group>
                    <group name="authorisation" string="Authorisation">
                        <field name="is_topup_allowed" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="topup_rule_view_search" model="ir.ui.view">
        <field name="name">topup.rule.view.search</field>
        <field name="model">topup.rule</field>
        <field name="arch" type="xml">
            <search string="Search topup rules">
                <field name="name" />
                <field name="wallet_domain" />
                <filter domain="[('active','=',True)]" string="Active" name="active" />
                <filter domain="[('active','=',False)]" string="Archived" name="archived" />
                <separator />
                <filter domain="[('is_topup_allowed','=',True)]" string="Topup ON"
                    name="topup_on" />
                <filter domain="[('is_topup_allowed','=',False)]" string="Topup OFF"
                    name="topup_off" />
            </search>
        </field>
    </record>
</odoo>
