<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wallet_form_view" model="ir.ui.view">
        <field name="name">wallet.form.view</field>
        <field name="model">res.partner.backend</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Digital Currency Wallet" create="0">
                <header>
                    <button name="%(action_create_credit_request_wizard)d"
                        string="New Credit Request"
                        class="oe_highlight" type="action"
                        groups="lcc_lokavaluto_app_connection.group_wallet_full_manager" />
                </header>
                <sheet string="Digital Currency Wallet">
                    <field name="active" invisible="True" />
                    <field name="is_reconversion_allowed" invisible="True" />
                    <field name="is_topup_allowed" invisible="True" />
                    <group name="general_info">
                        <group>
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="type" />
                            <field name="status" readonly="True" />
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"
                                   placeholder='e.g. "SSA"'/>
                        </group>
                    </group>
                    <div class="alert alert-success" role="alert"
                        attrs="{'invisible': [('is_reconversion_allowed','=',False)]}">
                        Reconversions are allowed on this wallet.</div>
                    <div class="alert alert-danger" role="alert"
                        attrs="{'invisible': [('is_reconversion_allowed','=',True)]}">
                        Reconversions are NOT allowed on this wallet.</div>
                    <div class="alert alert-success" role="alert"
                        attrs="{'invisible': [('is_topup_allowed','=',False)]}">
                        Topups are allowed on this wallet.</div>
                    <div class="alert alert-danger" role="alert"
                        attrs="{'invisible': [('is_topup_allowed','=',True)]}">
                        Topups are NOT allowed on this wallet.</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wallet_view_tree" model="ir.ui.view">
        <field name="name">wallet.view.tree</field>
        <field name="model">res.partner.backend</field>
        <field name="arch" type="xml">
            <tree string="Digital Currency Wallet">
                <field name="name" />
                <field name="partner_id" />
                <field name="type" />
                <field name="status" />
                <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </tree>
        </field>
    </record>

    <record id="wallet_view_search" model="ir.ui.view">
        <field name="name">wallet.view.search</field>
        <field name="model">res.partner.backend</field>
        <field name="arch" type="xml">
            <search string="Search wallets">
                <field name="name" string="Name" />
                <field name="partner_id" string="Contact" />
                <field name="type" string="Type" />
                <field name="category_id" string="Tags" />
                <filter domain="[('status','=','active')]" string="Active" name="active" />
                <filter domain="[('status','=','to_confirm')]" string="To confirm" name="to_confirm" />
                <filter domain="[('status','=','blocked')]" string="Blocked" name="blocked" />
                <filter domain="[('status','=','inactive')]" string="Inactive" name="inactive" />
            </search>
        </field>
    </record>

    <!-- Wallet Categories -->
    <record id="wallet_category_form_view" model="ir.ui.view">
        <field name="name">Wallet Tags</field>
        <field name="model">wallet.category</field>
        <field name="arch" type="xml">
            <form string="Wallet Tag">
                <sheet>
                    <group col="4">
                        <field name="name" placeholder='e.g. "SSA"'/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wallet_category_view_tree" model="ir.ui.view">
        <field name="name">wallet.category.view.tree</field>
        <field name="model">wallet.category</field>
        <field name="arch" type="xml">
            <tree string="Wallet Tag">
                <field name="name" />
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="wallet_category_view_search" model="ir.ui.view">
        <field name="name">wallet.category.view.search</field>
        <field name="model">wallet.category</field>
        <field name="arch" type="xml">
            <search string="Search Wallet Tag">
                <field name="name"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
