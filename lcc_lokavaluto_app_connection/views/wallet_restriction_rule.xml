<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wallet_restriction_rule_view_tree" model="ir.ui.view">
        <field name="name">wallet.restriction.rule.view.tree</field>
        <field name="model">wallet.restriction.rule</field>
        <field name="arch" type="xml">
            <tree string="Wallet Restriction Rules">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <field name="sender_wallet_domain" />
                <field name="recipient_wallet_domain" />
            </tree>
        </field>
    </record>

    <record id="wallet_restriction_rule_view_form" model="ir.ui.view">
        <field name="name">wallet.restriction.rule.view.form</field>
        <field name="model">wallet.restriction.rule</field>
        <field name="arch" type="xml">
            <form string="Wallet Restriction Rules">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}" />
                    <field name="active" invisible="True" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="domain" string="Sender Wallet Domain">
                        <field
                            name="sender_wallet_domain"
                            widget="domain"
                            options='{"model": "res.partner.backend"}' />
                    </group>
                    <group name="domain" string="Recipient Wallet Domain">
                        <field
                            name="recipient_wallet_domain"
                            widget="domain"
                            options='{"model": "res.partner.backend"}' />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wallet_restriction_rule_view_search" model="ir.ui.view">
        <field name="name">wallet.restriction.rule.view.search</field>
        <field name="model">wallet.restriction.rule</field>
        <field name="arch" type="xml">
            <search string="Search Wallet Restriction Rules">
                <field name="name" />
                <field name="sender_wallet_domain" />
                <field name="recipient_wallet_domain" />
                <filter domain="[('active','=',True)]" string="Active" name="active" />
                <filter domain="[('active','=',False)]" string="Archived" name="archived" />
            </search>
        </field>
    </record>
</odoo>
